# ── Sanity (CMS) ──────────────────────────────────────────────────────
# Skapa ett projekt på https://sanity.io och klistra in projectId här.
# Utan projectId fungerar sajten ändå – den läser då innehåll från
# datafilerna i src/lib/data/ (fallback).
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01

# Skrivnyckel – behövs ENDAST för engångs-migreringen (scripts/seed-sanity.mjs).
# Skapa under Sanity → API → Tokens (role: Editor). Lägg INTE i git.
SANITY_WRITE_TOKEN=

# ── Kontaktformulär (Resend) ──────────────────────────────────────────
# Behövs för att formuläret ska skicka mejl. Utan dessa fungerar resten.
RESEND_API_KEY=
RESEND_FROM=onboarding@resend.dev
# Valfritt: tvinga all post till en adress (annars info@erotikmassan.com).
# RESEND_TO_OVERRIDE=

# ── Google Analytics & Search Console (valfritt) ──────────────────────
# GA4 Mät-ID (börjar med "G-"). Sätt detta så aktiveras Google Analytics.
# Lämna tomt = ingen GA, inga GA-cookies. OBS: ha en cookie-/samtyckesbanner
# på plats innan GA aktiveras skarpt i EU.
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
#
# Search Console-verifiering: token från Google Search Console
# (metoden "HTML-tagg" → kopiera content-värdet). Lägger in <meta>-taggen.
# GOOGLE_SITE_VERIFICATION=

# ── Övrigt ────────────────────────────────────────────────────────────
# Sajtens publika URL (används i metadata/canonical). Default: erotikmassan.com
# NEXT_PUBLIC_SITE_URL=https://www.erotikmassan.com
